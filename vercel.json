{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/platform(/.*)?",
      "dest": "/public/platform/index.html"
    },
    {
      "src": "/([^/]+)/admin(.*)",
      "dest": "/public/admin/index.html"
    },
    {
      "src": "/([^/]+)/pedido/(.*)",
      "dest": "/public/tracking/index.html"
    },
    {
      "src": "/([^/]+)(/.*)?",
      "dest": "/public/store/index.html"
    }
  ]
}
