{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/platform/(.*)", "destination": "/public/platform/index.html" },
    { "source": "/platform", "destination": "/public/platform/index.html" },
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/:slug/admin(.*)", "destination": "/public/admin/index.html" },
    { "source": "/:slug/pedido/:token", "destination": "/public/tracking/index.html" },
    { "source": "/:slug/(.*)", "destination": "/public/store/index.html" },
    { "source": "/:slug", "destination": "/public/store/index.html" }
  ]
}
